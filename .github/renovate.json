{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:monorepos"],
  "timezone": "America/New_York",
  "packageRules": [
    {
      "description": "TypeScript 7 is the native port; Expo SDK 57 and typescript-eslint need 6.x",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Vitest 5 breaks the Cloudflare Workers pool",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "allowedVersions": "<5"
    },
    {
      "description": "Wrangler and its test plugin must move together, one version per install",
      "groupName": "cloudflare workers toolchain",
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/vitest-plugin",
        "@cloudflare/workers-types",
        "miniflare"
      ]
    },
    {
      "description": "Expo majors are an SDK upgrade with native side effects, never automatic",
      "matchPackageNames": ["expo", "expo-*", "@expo/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
