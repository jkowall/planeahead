# Local variables and secrets for `wrangler dev`. Copy to `.dev.vars` and fill in.
#
# `.dev.vars` is gitignored; this template is not. `.dev.vars.<environment>` REPLACES `.dev.vars`
# entirely when you pass `--env <environment>`, it does not merge with it, so a `.dev.vars.staging`
# has to repeat every line it needs.
#
# None of this reaches the Vitest pool. `pnpm --filter @planeahead/api test` reads its secrets
# from `.dev.vars.test` (committed, generated dummy values) through test/globalSetup.ts, and its
# database from the embedded PostgreSQL 18 cluster that setup starts (or TEST_DATABASE_URL in CI).
#
# test/workers/secrets-in-logs.test.ts asserts that every name in WORKER_SECRET_NAMES (src/env.ts)
# is an uncommented key in this file, so a new secret cannot be read by the Worker without being
# listed here.

# Overrides the Hyperdrive binding's connection string for `wrangler dev` only. Point it at your
# own Neon branch (for example dev-jkowall); there is no local Postgres and no Docker in this
# project. The variable name is CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING>.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=postgres://user:password@ep-example.us-east-1.aws.neon.tech/planeahead

# Mirrors the `vars.ENVIRONMENT` in wrangler.jsonc. Keep it `local`.
ENVIRONMENT=local

# Leave empty to run without Sentry: the SDK initialises and drops every event.
SENTRY_DSN=

# `wrangler dev --env staging` needs the line above even though the staging Hyperdrive binding has
# no localConnectionString of its own: environment blocks do not inherit it, and wrangler refuses
# to start a local Hyperdrive without one.

# ---------------------------------------------------------------------------------------------
# Authentication and encryption (increment 5). Set every one of these with
# `wrangler secret put <NAME> --env staging` (and again for production) before sign-in works.

# Better Auth's session signing secret. At least 32 random characters (`openssl rand -base64 48`).
# createAuth refuses to start without it: Better Auth would otherwise fall back to a PUBLIC
# default secret, because it keys that check on NODE_ENV, which Workers never set.
BETTER_AUTH_SECRET=

# Key-encryption key, version 1: 32 random bytes as STANDARD padded base64
# (`openssl rand -base64 32`). base64url is rejected. Add TOKEN_KEK_V2 to rotate; keep V1 until
# every user_keys row has been re-wrapped (docs/security/threat-model.md section 2).
TOKEN_KEK_V1=

# Sign in with Apple: the .p8 private key as PKCS8 PEM with the newlines written as \n on one
# line, its key id, the team id, and the iOS bundle id (the `aud` of native identity tokens and
# the `client_id` at Apple's token endpoint).
APPLE_SIWA_P8=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_TEAM_ID=
APPLE_BUNDLE_ID=

# Google: the three OAuth client ids a native identity token may name as `aud`. No client secret
# is needed: the native flow verifies the ID token's signature against Google's JWKS.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Resend API key for magic-link mail. Empty means the logging NoopSender (wrangler dev only).
RESEND_API_KEY=

# Optional test seams. NEVER set in a deployed environment: each one points the Worker at a
# different host for one external endpoint. The suite sets them to test/fake-providers.ts.
APPLE_JWKS_URL=
APPLE_TOKEN_URL=
APPLE_REVOKE_URL=
GOOGLE_JWKS_URL=
RESEND_API_URL=

# ---------------------------------------------------------------------------------------------
# Flight data providers (increment 6). Secrets: `wrangler secret put <NAME> --env staging`.

# AeroDataBox direct-gateway key (the `X-Api-Key` header), the primary provider. Empty means the
# provider router refuses to build the adapter (ProviderConfigError) rather than calling without it.
AERODATABOX_API_KEY=
# FlightAware AeroAPI key (the `x-apikey` header). Unused while AEROAPI_MODE is `mock`.
AEROAPI_API_KEY=

# Webhook path tokens, one per provider AND per environment, 256 bits each: 43 base64url
# characters (`openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`) or 64 hex characters. They are
# the ONLY authentication on POST /v1/webhooks/aerodatabox/{token} and /v1/webhooks/aeroapi/{token}
# (neither provider signs its deliveries). A missing or shorter token disables the receiver: every
# request answers 404. Never reuse a token across environments.
WEBHOOK_TOKEN_AERODATABOX=
WEBHOOK_TOKEN_AEROAPI=

# Provider settings. Not secrets; each has a cautious default in src/providers/config.ts when
# unset: AeroAPI mocked, the AeroDataBox Starter limits, AeroDataBox alerts off.
# `mock` routes every cadence window to AeroDataBox and never calls AeroAPI; `live` enables it.
AEROAPI_MODE=mock
# The AeroDataBox plan: `starter`, `growth` or `scale` (per-second limit 5 / 10 / 20, lookahead
# 180 / 365 / 365 days, FIDS window 12 / 24 / 48 hours). Growth is the planned floor: Starter's
# 7-day caching term forbids keeping flight instances in Postgres and R2.
ADB_PLAN=growth
# `true` opens the AeroDataBox webhook receiver. Phase 0 has no subscription, so it stays false.
ADB_ALERTS_ENABLED=false

# Test-only seams (increment 7). NEVER set in a deployed environment or in `.dev.vars`.
# AERODATABOX_BASE_URL points the router's AeroDataBox adapter at another host; the Workers suite
# sets it to the fake provider server (test/fake-providers.ts) so FlightTracker alarms fetch
# scripted fixtures through the real adapter. TEST_CLOCK=true enables the `_setClock` RPC on the
# FlightTracker and DesignatorResolver objects; test/globalSetup.ts is the only place that sets it.
# AERODATABOX_BASE_URL=
# TEST_CLOCK=

# ---------------------------------------------------------------------------------------------
# Account deletion and anonymous caps (increment 8). Secrets: `wrangler secret put <NAME>`.

# HMAC-SHA-256 key for deleted_subjects.provider_subject_hash: the Apple and Google subjects and
# the session tokens of a deleted account are kept only as keyed hashes (400 and 31 days), so a
# late webhook can be matched and a second device answered 401 account_deleted. At least 32
# characters (`openssl rand -base64 32`). Missing means POST /v1/me/delete refuses with a 500
# before it touches anything. Never reuse across environments.
DELETED_SUBJECT_HMAC_KEY=
# Root of the daily salt for the anonymous per-IP tracker-creation cap: usage_counters stores
# HMAC(HMAC(this, UTC day), CF-Connecting-IP), never an address. At least 32 characters.
IP_SALT_SECRET=
# `true` calls RevenueCat's DELETE /v1/subscribers/{id} on account deletion. Off in Phase 0: the
# call is a typed stub that logs what it would have done.
REVENUECAT_DELETE_ENABLED=false
