{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // The Workers runtime types come from worker-configuration.d.ts, generated by `wrangler types`
    // and committed. `node` stays in the list for the ambient types vitest.config.ts and the test
    // helpers need; nothing under src/ may import a node: module that nodejs_compat does not
    // provide. @cloudflare/workers-types is deliberately NOT a dependency: it would declare the
    // same globals a second time, and @sentry/hono's optional peer on its 4.x line conflicts with
    // the 5.x line workerd 1.20260918.1 actually implements.
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  // src/**/*.json: the provider fixtures (src/providers/fixtures) that the adapter tests import.
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.exit-guard.config.ts",
    "worker-configuration.d.ts"
  ],
  // test/consumer is the mobile app's view of the emitted client declaration, checked by its own
  // tsconfig after `tsc -b` (the `typecheck` script); inside this project it would read its own
  // output.
  "exclude": ["test/consumer/**"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/db" }]
}
