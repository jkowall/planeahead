{
  "name": "@planeahead/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./src/client.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen:migration-hash": "node ../../scripts/gen-migration-hash.mjs",
    "typecheck": "pnpm run gen:migration-hash && tsc -b && tsc -p test/consumer/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm run gen:migration-hash && vitest run",
    "dev": "pnpm run gen:migration-hash && wrangler dev",
    "cf-typegen": "wrangler types",
    "deploy:dry-run": "wrangler deploy --dry-run --env staging"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@planeahead/db": "workspace:*",
    "@planeahead/shared": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "@sentry/hono": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/runner": "catalog:",
    "@vitest/snapshot": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
