# Continuous native generation: ios/ and android/ are generated by `expo prebuild`, never committed.
/ios/
/android/
# Generated at dev-server start or by `expo customize tsconfig.json` (CI runs the latter).
.expo/
expo-env.d.ts
# `expo export` output for the source-map upload step.
/dist/
# Firebase configs arrive as EAS file variables (GOOGLE_SERVICES_JSON), never from the repository.
google-services*.json
GoogleService-Info*.plist
