{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "*.ts",
        "tsconfig.json",
        "../../tsconfig.base.json",
        // `scripts/**` above resolves inside the PACKAGE (apps/api/scripts), which does not
        // exist. The api typecheck and test scripts both start by running the repo-root
        // generator, so the generator and its only input have to be named explicitly or a new
        // migration cache-hits and replays a stale "up to date" line while the compiled-in
        // MIGRATION_HASH still reports the previous schema.
        "../../scripts/gen-migration-hash.mjs",
        "../../packages/db/migrations/meta/_journal.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "*.ts",
        "../../eslint.config.js",
        "../../tools/eslint/**"
      ]
    },
    "test": {
      "dependsOn": ["//#test:tools"],
      // turbo runs tasks in strict env mode: a variable not listed here never reaches the
      // script. CI sets TEST_DATABASE_URL to its postgres:18 service container for the db and
      // api suites; without this line both would start embedded-postgres on the runner instead,
      // and the containers would be dead weight. apps/api/test/globalSetup.ts throws when the
      // variable is set and the harness did not use it.
      "env": ["TEST_DATABASE_URL"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "README.md",
        "tsconfig.json",
        "vitest.config.ts",
        "../../docs/architecture.md",
        "../../docs/adr/**",
        // Same reason as typecheck: `pnpm --filter @planeahead/api test` regenerates
        // src/generated/migration-hash.ts before vitest runs.
        "../../scripts/gen-migration-hash.mjs",
        "../../packages/db/migrations/meta/_journal.json"
      ],
      "outputs": []
    },
    "//#lint:root": {
      "inputs": ["eslint.config.js", "scripts/**", "tools/**"]
    },
    "//#test:tools": {
      // The ESLint rule tests, the workflow tests (the migration-hash order, every workflow's job
      // keys, the native-smoke shape, the production deploy's shape and its /health smoke) and the
      // mobile migrations guard's test. The workflow files and the scripts are read by those
      // tests, so they are inputs too or a change would cache-hit against a stale pass; the smoke
      // script's test reads the generated hash and the Durable Object classes.
      "inputs": [
        "tools/**",
        ".github/workflows/**",
        "scripts/mobile-migrations-guard.mjs",
        "scripts/native-smoke.sh",
        "scripts/health-smoke.mjs",
        "apps/api/src/generated/migration-hash.ts",
        "apps/api/src/do/*.ts"
      ]
    },
    "//#format:check": {
      "cache": false
    }
  }
}
