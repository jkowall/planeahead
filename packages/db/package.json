{
  "name": "@planeahead/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    },
    "./seed": {
      "types": "./src/seed/index.ts",
      "default": "./src/seed/index.ts"
    },
    "./test-harness": {
      "types": "./test/harness.ts",
      "default": "./test/harness.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "seed:fetch": "node scripts/fetch-seed-data.mjs"
  },
  "dependencies": {
    "@planeahead/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "async-exit-hook": "catalog:",
    "drizzle-kit": "catalog:",
    "embedded-postgres": "catalog:",
    "eslint": "catalog:",
    "geo-tz": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
